---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { pathFor } from '../lib/paths';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const experienceEntries = experience.map((item) => ({ ...item, href: `/experience/${item.id}/` }));
---

<BaseLayout title="Home" description="Nicole Lyu's portfolio: AI systems, research, and projects." active="home">
  <section class="hero">
    <div class="hero-meta"><span>01 / INTRODUCTION</span><span>SCROLL TO EXPLORE ↓</span></div>
    <div class="hero-main">
      <p class="hero-overline">ENGINEER <span>·</span> RESEARCHER <span>·</span> BUILDER</p>
      <h1>HI, I'M<br /><span>NICOLE.</span></h1>
      <p class="hero-description">I build AI systems that make ambitious ideas usable.</p>
    </div>
    <div class="hero-bottom"><span>TECHNOLOGY, RESEARCH, AND EVERYTHING IN BETWEEN.</span><span>BASED IN PITTSBURGH, PA</span></div>
  </section>

  <section class="statement-band" aria-label="Introduction">
    <span class="eyebrow">A LITTLE ABOUT ME</span>
    <p>From machine learning infrastructure to responsible AI research, I work where complex technology meets real people.</p>
  </section>

  <section class="content-section" aria-labelledby="experience-title">
    <div class="section-heading"><div><span class="eyebrow">02 / EXPERIENCE</span><h2 id="experience-title">EXPERIENCE</h2></div><a class="text-link" href={pathFor('/experience/')}>ALL EXPERIENCE ↗</a></div>
    <p class="experience-intro">My work spans technology consulting, AI for B2B sales automation at a startup, and AI/ML infrastructure at a hedge fund.</p>
    <div class="card-grid experience-grid">
      {experienceEntries.map((item, index) => <ExperienceCard number={String(index + 1).padStart(2, '0')} organization={item.data.organization} context={item.data.context} role={item.data.role} description={item.data.description} period={item.data.period} href={item.href} />)}
    </div>
  </section>

  <section class="research-band">
    <div><span class="eyebrow">03 / RESEARCH + PROJECTS</span><h2>BUILDING WITH<br /><em>INTENTION.</em></h2></div>
    <div class="research-band-side"><p>Questions about reliability, accountability, and useful AI shape the work I choose to do.</p><a class="outline-link research-link" href={pathFor('/research/')}>EXPLORE RESEARCH & PROJECTS <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="writing-teaser"><div><span class="eyebrow">04 / NOTES IN PROGRESS</span><h2>WRITING</h2></div><p>A space for ideas, experiments, and things I’m learning. First posts are on the way.</p><a class="text-link" href={pathFor('/writing/')}>VISIT WRITING ↗</a></section>
</BaseLayout>
